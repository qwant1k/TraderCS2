# Copy this file to .env and fill in the values.
DATABASE_URL="file:./dev.db"
# Public site URL used for the Steam OpenID return_to value.
APP_URL="http://localhost:3000"
# Generate a unique random value with at least 32 characters.
SESSION_SECRET="replace-with-a-long-random-secret"
# Optional Steam Web API key for profile names and avatars.
STEAM_API_KEY=""

# Email verification via https://resend.com
RESEND_API_KEY=""
# Sender address from a domain verified in Resend.
EMAIL_FROM="TradeGG <noreply@example.com>"
