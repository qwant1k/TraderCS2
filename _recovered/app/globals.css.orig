/* Восстановлено из собранного CSS (.next/static/chunks/2sb-56y3uk68x.css, сборка до перезаписи). Комментарии исходника потеряны, цвета записаны в hex. */
* {
  box-sizing: border-box;
}
html {
  --lightningcss-light: ;
  --lightningcss-dark: initial;
  color-scheme: dark;
}
body {
  color: var(--text);
  background: radial-gradient(
      900px 500px at 10% -10%,
      #8b5cf62e,
      transparent 60%
    ),
    radial-gradient(800px 500px at 100% 0%, #19e3ff1f, transparent 60%),
    radial-gradient(700px 500px at 50% 120%, #ff3db814, transparent 60%),
    var(--bg);
  background-attachment: fixed;
  min-height: 100vh;
  margin: 0;
  font:
    15px/1.55 Inter,
    Segoe UI,
    system-ui,
    -apple-system,
    sans-serif;
}
a {
  color: var(--cyan);
  text-decoration: none;
}
a:hover {
  text-decoration: underline;
}
.wrap {
  max-width: none;
  margin: 0;
  padding: 0 12px 40px;
}
header.top {
  z-index: 20;
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--line);
  background: #06080db3;
  position: sticky;
  top: 0;
}
header.top .wrap {
  align-items: center;
  gap: 28px;
  padding-top: 12px;
  padding-bottom: 12px;
  display: flex;
}
.logo {
  letter-spacing: 0.3px;
  color: var(--text);
  align-items: center;
  gap: 10px;
  font-size: 19px;
  font-weight: 800;
  display: flex;
}
.logo:hover {
  text-decoration: none;
}
.logo i {
  background: var(--grad);
  width: 26px;
  height: 26px;
  box-shadow: var(--glow);
  border-radius: 8px;
  display: inline-block;
  position: relative;
}
.logo i:after {
  content: "⇄";
  color: #06080d;
  place-items: center;
  font-size: 15px;
  font-style: normal;
  font-weight: 900;
  display: grid;
  position: absolute;
  inset: 0;
}
.logo b {
  background: var(--grad);
  color: #0000;
  -webkit-background-clip: text;
  background-clip: text;
}
header.top nav {
  flex: 1;
  gap: 6px;
  display: flex;
}
header.top nav a {
  color: var(--muted);
  border-radius: 10px;
  padding: 7px 12px;
  font-weight: 500;
}
header.top nav a:hover {
  color: var(--text);
  background: #ffffff0d;
  text-decoration: none;
}
.user {
  align-items: center;
  gap: 10px;
  display: flex;
}
.user .name {
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 140px;
  color: var(--text);
  font-weight: 600;
  overflow: hidden;
}
.avatar {
  object-fit: cover;
  background: var(--panel2);
  border: 2px solid var(--line-strong);
  border-radius: 50%;
  display: inline-block;
}
.avatar.ph {
  color: var(--muted);
  place-items: center;
  font-weight: 700;
  display: inline-grid;
}
h1 {
  letter-spacing: -0.3px;
  margin: 34px 0 14px;
  font-size: 32px;
  line-height: 1.15;
}
h2 {
  letter-spacing: -0.1px;
  margin: 30px 0 12px;
  font-size: 19px;
}
.grad-text {
  background: var(--grad);
  color: #0000;
  -webkit-background-clip: text;
  background-clip: text;
}
.muted {
  color: var(--muted);
  font-size: 13px;
}
.lead {
  color: var(--muted);
  max-width: 640px;
  font-size: 17px;
}
.card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
  margin-bottom: 14px;
  padding: 16px;
  transition:
    border-color 0.15s,
    transform 0.15s,
    box-shadow 0.15s;
}
a.card {
  color: inherit;
  display: block;
}
a.card:hover,
.card.hover:hover {
  border-color: var(--line-strong);
  box-shadow: var(--glow);
  text-decoration: none;
}
.row {
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  display: flex;
}
.between {
  justify-content: space-between;
}
.stack > * + * {
  margin-top: 12px;
}
.btn {
  background: var(--grad);
  color: #04060b;
  font: inherit;
  cursor: pointer;
  border: 0;
  border-radius: 11px;
  justify-content: center;
  align-items: center;
  gap: 8px;
  padding: 9px 16px;
  font-weight: 700;
  transition:
    transform 0.12s,
    filter 0.12s,
    box-shadow 0.12s;
  display: inline-flex;
  box-shadow: 0 6px 22px #8b5cf640;
}
.btn:hover {
  filter: brightness(1.08);
  text-decoration: none;
  transform: translateY(-1px);
  box-shadow: 0 8px 28px #19e3ff47;
}
.btn:active {
  transform: translateY(0);
}
.btn.secondary {
  border: 1px solid var(--line-strong);
  color: var(--text);
  box-shadow: none;
  background: #ffffff0d;
  font-weight: 600;
}
.btn.ok {
  background: linear-gradient(135deg, #2ee59d, #19e3ff);
}
.btn.bad {
  color: #fff;
  background: linear-gradient(135deg, #ff5470, #ff3db8);
}
.btn.big {
  border-radius: 13px;
  padding: 13px 24px;
  font-size: 16px;
}
.btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
  filter: none;
  transform: none;
}
input,
textarea,
select {
  width: 100%;
  color: var(--text);
  border: 1px solid var(--line);
  font: inherit;
  background: #080c14cc;
  border-radius: 11px;
  padding: 10px 12px;
  transition:
    border-color 0.15s,
    box-shadow 0.15s;
}
input:focus,
textarea:focus,
select:focus {
  border-color: var(--cyan);
  outline: none;
  box-shadow: 0 0 0 3px #19e3ff26;
}
label {
  color: var(--muted);
  margin: 12px 0 5px;
  font-size: 13px;
  display: block;
}
input[type="radio"],
input[type="checkbox"] {
  width: auto;
}
.grid {
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 12px;
  display: grid;
}
.item {
  --rc: var(--line-strong);
  text-align: center;
  border: 1px solid var(--line);
  background: linear-gradient(#172033e6, #0c111ce6);
  border-radius: 12px;
  padding: 10px 8px 9px;
  transition:
    transform 0.15s,
    border-color 0.15s,
    box-shadow 0.15s;
  position: relative;
  overflow: hidden;
}
.item:before {
  content: "";
  background: var(--rc);
  height: 3px;
  box-shadow: 0 0 14px var(--rc);
  position: absolute;
  inset: 0 0 auto;
}
.item:after {
  content: "";
  pointer-events: none;
  background: radial-gradient(
    120px 90px at 50% 25%,
    color-mix(in srgb, var(--rc) 22%, transparent),
    transparent 70%
  );
  position: absolute;
  inset: 0;
}
.item img {
  z-index: 1;
  object-fit: contain;
  filter: drop-shadow(0 6px 10px #00000080);
  width: 100%;
  height: 84px;
  position: relative;
}
.item .n {
  z-index: 1;
  min-height: 31px;
  margin-top: 6px;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.3;
  position: relative;
}
.item .p {
  z-index: 1;
  color: var(--muted);
  margin-top: 3px;
  font-size: 11px;
  position: relative;
}
.item.pick {
  cursor: pointer;
}
.item.pick:hover {
  border-color: var(--line-strong);
  transform: translateY(-2px);
}
.item.sel .check {
  display: grid;
}
.item .check {
  z-index: 2;
  background: var(--cyan);
  color: #04060b;
  border-radius: 50%;
  place-items: center;
  width: 20px;
  height: 20px;
  font-size: 12px;
  font-weight: 900;
  display: none;
  position: absolute;
  top: 8px;
  right: 8px;
}
.tag {
  letter-spacing: 0.3px;
  text-transform: uppercase;
  border: 1px solid var(--line);
  color: var(--muted);
  background: #ffffff0d;
  border-radius: 999px;
  align-items: center;
  gap: 6px;
  padding: 3px 10px;
  font-size: 11px;
  font-weight: 600;
  display: inline-flex;
}
.tag.PENDING {
  color: var(--warn);
  border-color: #ffb02059;
}
.tag.ACCEPTED,
.tag.COMPLETED,
.tag.ACTIVE,
.tag.RESERVED,
.tag.CLOSED {
  color: var(--ok);
  border-color: #2ee59d59;
}
.tag.DECLINED,
.tag.INVALID,
.tag.CANCELLED {
  color: var(--bad);
  border-color: #ff547059;
}
.tag.open {
  color: var(--cyan);
  border-color: #19e3ff59;
}
.tag.want {
  color: var(--pink);
  border-color: #ff3db859;
}
.msg {
  border: 1px solid var(--line);
  background: #ffffff0a;
  border-radius: 11px;
  margin: 12px 0;
  padding: 11px 14px;
}
.two {
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  display: grid;
}
@media (max-width: 760px) {
  .two {
    grid-template-columns: 1fr;
  }
  header.top nav {
    display: none;
  }
  h1 {
    font-size: 26px;
  }
}
.hero {
  padding: 54px 0 30px;
}
.hero h1 {
  letter-spacing: -1px;
  margin: 0 0 18px;
  font-size: 52px;
  line-height: 1.05;
}
@media (max-width: 760px) {
  .hero h1 {
    font-size: 36px;
  }
}
.stats {
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 12px;
  margin: 28px 0;
  display: grid;
}
.stat {
  border-radius: var(--radius);
  background: var(--panel);
  border: 1px solid var(--line);
  padding: 16px;
}
.stat b {
  background: var(--grad);
  color: #0000;
  -webkit-background-clip: text;
  background-clip: text;
  font-size: 28px;
  line-height: 1.1;
  display: block;
}
.steps {
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 12px;
  display: grid;
}
.step {
  border-radius: var(--radius);
  background: var(--panel);
  border: 1px solid var(--line);
  padding: 18px;
}
.step .num {
  color: #04060b;
  background: var(--grad);
  border-radius: 9px;
  place-items: center;
  width: 30px;
  height: 30px;
  margin-bottom: 10px;
  font-weight: 800;
  display: grid;
}
.step b {
  margin-bottom: 4px;
  display: block;
}
.profile-head {
  padding: 0;
  position: relative;
  overflow: hidden;
}
.profile-banner {
  background: var(--grad);
  opacity: 0.55;
  filter: saturate(1.2);
  height: 110px;
}
.profile-body {
  flex-wrap: wrap;
  align-items: flex-end;
  gap: 20px;
  margin-top: -42px;
  padding: 0 22px 20px;
  display: flex;
}
.profile-body .avatar {
  border: 4px solid var(--bg2);
  width: 96px;
  height: 96px;
  box-shadow: var(--glow);
}
.profile-info {
  flex: 1;
  min-width: 220px;
}
.profile-info h1 {
  margin: 0;
  font-size: 28px;
}
.level {
  border: 1px solid var(--line-strong);
  background: #ffffff0d;
  border-radius: 999px;
  align-items: center;
  gap: 8px;
  padding: 4px 12px;
  font-size: 13px;
  font-weight: 700;
  display: inline-flex;
}
.level.l0 {
  color: var(--muted);
}
.level.l1 {
  color: var(--cyan);
  border-color: #19e3ff66;
}
.level.l2 {
  color: var(--violet);
  border-color: #8b5cf680;
}
.level.l3 {
  color: var(--ok);
  border-color: #2ee59d80;
  box-shadow: 0 0 16px #2ee59d33;
}
.meter {
  background: #ffffff12;
  border-radius: 99px;
  height: 8px;
  overflow: hidden;
}
.meter i {
  background: var(--grad);
  border-radius: 99px;
  height: 100%;
  display: block;
}
.checklist {
  margin: 10px 0 0;
  padding: 0;
  list-style: none;
}
.checklist li {
  color: var(--muted);
  align-items: center;
  gap: 10px;
  padding: 5px 0;
  display: flex;
}
.checklist li.done {
  color: var(--text);
}
.checklist li .dot {
  border: 2px solid var(--line-strong);
  color: #04060b;
  border-radius: 50%;
  place-items: center;
  width: 18px;
  height: 18px;
  font-size: 11px;
  font-weight: 900;
  display: grid;
}
.checklist li.done .dot {
  background: var(--ok);
  border-color: var(--ok);
}
.socials {
  flex-wrap: wrap;
  gap: 8px;
  display: flex;
}
.social {
  border: 1px solid var(--line);
  color: var(--text);
  background: #ffffff0a;
  border-radius: 9px;
  padding: 4px 10px;
  font-size: 13px;
}
.tabs {
  border-bottom: 1px solid var(--line);
  gap: 6px;
  margin: 22px 0 14px;
  display: flex;
}
.tabs a {
  color: var(--muted);
  border-bottom: 2px solid #0000;
  padding: 9px 14px;
  font-weight: 600;
}
.tabs a.on {
  color: var(--text);
  border-color: var(--cyan);
}
.tabs a:hover {
  color: var(--text);
  text-decoration: none;
}
.staging .empty {
  border: 1px dashed var(--line-strong);
  text-align: center;
  color: var(--muted);
  border-radius: 12px;
  margin: 14px 0 4px;
  padding: 18px;
}
.chips {
  flex-wrap: wrap;
  gap: 10px;
  margin: 14px 0 4px;
  display: flex;
}
.chip {
  --rc: var(--line-strong);
  border: 1px solid var(--rc);
  background: #080c14b3;
  border-radius: 11px;
  align-items: center;
  gap: 8px;
  padding: 6px 8px 6px 6px;
  display: flex;
}
.chip img {
  object-fit: contain;
  width: 46px;
  height: 34px;
}
.chip .cn {
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 170px;
  font-size: 12px;
  font-weight: 600;
  overflow: hidden;
}
.chip button {
  color: var(--text);
  cursor: pointer;
  background: #ffffff14;
  border: 0;
  border-radius: 50%;
  width: 22px;
  height: 22px;
}
.staging-form {
  border-top: 1px solid var(--line);
  margin-top: 14px;
  padding-top: 4px;
}
.vnum {
  background: var(--grad);
  color: #04060b;
  border-radius: 50%;
  flex: none;
  place-items: center;
  width: 24px;
  height: 24px;
  font-size: 12px;
  font-weight: 800;
  display: grid;
}
.chk {
  color: var(--text);
  cursor: pointer;
  align-items: center;
  gap: 6px;
  margin: 0;
  font-size: 14px;
  display: inline-flex;
}
.toolbar {
  z-index: 5;
  background: linear-gradient(180deg, var(--bg) 70%, transparent);
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin: 4px 0 14px;
  padding: 10px 0;
  display: flex;
  position: sticky;
  top: 57px;
}
.toolbar input,
.toolbar select {
  padding: 8px 10px;
}
.inv-layout {
  grid-template-columns: 1fr;
  align-items: start;
  gap: 16px;
  display: grid;
}
.inv-layout.with-card {
  grid-template-columns: minmax(0, 1fr) 420px;
}
.side {
  max-height: calc(100vh - 140px);
  position: sticky;
  top: 120px;
  overflow: auto;
}
@media (max-width: 980px) {
  .inv-layout.with-card {
    grid-template-columns: 1fr;
  }
  .side {
    max-height: none;
    position: static;
  }
  .toolbar {
    position: static;
  }
}
.item .plus {
  z-index: 3;
  border: 1px solid var(--line-strong);
  width: 24px;
  height: 24px;
  color: var(--text);
  cursor: pointer;
  background: #06080dcc;
  border-radius: 50%;
  font-weight: 800;
  line-height: 1;
  position: absolute;
  top: 7px;
  left: 7px;
}
.item .plus:hover,
.item.sel .plus {
  background: var(--cyan);
  color: #04060b;
  border-color: var(--cyan);
}
.item.busy {
  opacity: 0.45;
}
.open-win {
  z-index: 3;
  border: 1px solid var(--line);
  width: 22px;
  height: 22px;
  color: var(--muted);
  background: #06080dbf;
  border-radius: 7px;
  place-items: center;
  font-size: 12px;
  display: grid;
  position: absolute;
  top: 7px;
  right: 7px;
}
.open-win:hover {
  color: var(--cyan);
  text-decoration: none;
}
.icard {
  --rc: var(--line-strong);
  border: 1px solid var(--line-strong);
  border-radius: var(--radius);
  background: var(--panel-solid);
  overflow: hidden;
}
.icard-img {
  background: radial-gradient(
      260px 160px at 50% 45%,
      color-mix(in srgb, var(--rc) 28%, transparent),
      transparent 75%
    ),
    #ffffff05;
  border-bottom: 3px solid var(--rc);
  padding: 18px 12px 6px;
  position: relative;
}
.icard-img img {
  object-fit: contain;
  filter: drop-shadow(0 12px 18px #0009);
  width: 100%;
  max-height: 230px;
  display: block;
}
.icard-img .x {
  border: 1px solid var(--line-strong);
  width: 28px;
  height: 28px;
  color: var(--text);
  cursor: pointer;
  background: #06080dcc;
  border-radius: 50%;
  font-size: 16px;
  position: absolute;
  top: 8px;
  right: 8px;
}
.icard-body h3 {
  margin: 0 0 8px;
  font-size: 18px;
  line-height: 1.25;
}
.kv {
  justify-content: space-between;
  align-items: baseline;
  padding: 4px 0;
  display: flex;
}
.sticker {
  text-align: center;
  width: 74px;
  color: var(--muted);
  flex-direction: column;
  align-items: center;
  font-size: 10px;
  display: flex;
}
.sticker img {
  object-fit: contain;
  width: 56px;
  height: 42px;
}
.ptable {
  border-collapse: collapse;
  width: 100%;
  font-size: 14px;
}
.ptable td {
  border-bottom: 1px solid var(--line);
  padding: 6px 4px;
}
.ptable td:nth-child(2) {
  text-align: right;
  font-variant-numeric: tabular-nums;
}
.ptable td:nth-child(3) {
  text-align: right;
  width: 64px;
  font-size: 12px;
}
.variants {
  margin: 0;
  padding-left: 22px;
}
.variants li {
  margin: 4px 0;
  font-weight: 600;
}
body.popup header.top {
  display: none;
}
body.popup .wrap {
  padding-top: 0;
}
.btn.small {
  padding: 6px 10px;
  font-size: 12px;
}
.viewer img {
  max-width: 100%;
}
.mlist {
  margin: 0;
  padding-left: 18px;
  font-size: 13px;
}
.item.sel:after {
  content: "✓";
  background: var(--cyan);
  color: #04060b;
  z-index: 3;
  border-radius: 50%;
  place-items: center;
  width: 22px;
  height: 22px;
  font-size: 13px;
  font-weight: 800;
  display: grid;
  position: absolute;
  top: 7px;
  left: 7px;
}
.grid {
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
}
.icard-img,
.viewer {
  position: relative;
}
.vtools {
  flex-direction: column;
  gap: 6px;
  margin-top: 28px;
  display: flex;
  position: absolute;
  top: 0;
  right: 0;
}
.vbtn {
  border: 1px solid var(--line-strong);
  width: 34px;
  height: 34px;
  color: var(--text);
  cursor: pointer;
  background: #06080dcc;
  border-radius: 9px;
  place-items: center;
  padding: 0;
  display: grid;
}
.vbtn:hover {
  color: var(--cyan);
  border-color: var(--cyan);
  text-decoration: none;
}
.item-quick {
  z-index: 6;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  background: linear-gradient(#04070c47, #04070c1a 42%, #04070cf0);
  flex-direction: column;
  justify-content: space-between;
  padding: 8px;
  transition:
    opacity 0.16s,
    visibility 0.16s;
  display: flex;
  position: absolute;
  inset: 0;
}
.item:hover .item-quick,
.item:focus-within .item-quick {
  opacity: 1;
  visibility: visible;
}
.item-quick-actions {
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 6px;
  transition: transform 0.16s;
  display: flex;
  transform: translateY(-5px);
}
.item:hover .item-quick-actions,
.item:focus-within .item-quick-actions {
  transform: none;
}
.item-quick-btn {
  color: #fff;
  letter-spacing: 0.04em;
  cursor: pointer;
  pointer-events: auto;
  background: #06090feb;
  border: 1px solid #fff3;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  gap: 5px;
  min-height: 30px;
  padding: 6px 8px;
  font: 800 9px/1 system-ui;
  display: inline-flex;
  box-shadow: 0 5px 16px #00000073;
}
.item-quick-btn svg {
  fill: none;
  stroke: currentColor;
  stroke-width: 2px;
  width: 14px;
  height: 14px;
}
.item-quick-btn.trade.selected {
  color: #ff8da0;
  border-color: #ff5470b3;
}
.item-quick-btn:hover {
  filter: brightness(1.2);
  transform: translateY(-1px);
}
.item-quick-btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
  transform: none;
}
.item-quick-float {
  color: #fff;
  pointer-events: none;
  background: #070c15f0;
  border: 1px solid #19e3ff80;
  border-radius: 8px;
  justify-content: space-between;
  align-items: center;
  gap: 7px;
  width: 100%;
  padding: 6px 8px;
  display: flex;
  box-shadow: 0 0 18px #19e3ff24;
}
.item-quick-float span {
  letter-spacing: 0.12em;
  color: var(--cyan);
  font-size: 8px;
  font-weight: 800;
}
.item-quick-float strong {
  font-variant-numeric: tabular-nums;
  font-size: 10px;
}
.item-quick-float.empty {
  box-shadow: none;
  border-color: #ffffff24;
}
.item-quick-float.empty span {
  color: var(--muted);
}
.float-current {
  border: 1px solid #0000;
  border-radius: 10px;
  margin: -5px -7px 8px;
  padding: 5px 7px 7px;
  transition:
    border-color 0.16s,
    background 0.16s,
    box-shadow 0.16s;
}
.vbtn-3d,
.trade-toggle {
  transition:
    border-color 0.16s,
    color 0.16s,
    background 0.16s,
    box-shadow 0.16s,
    transform 0.16s;
}
.icard:has(.viewer:hover) .vbtn-3d {
  color: #061017;
  background: var(--cyan);
  border-color: var(--cyan);
  transform: scale(1.08);
  box-shadow: 0 0 22px #19e3ff8c;
}
.icard:has(.viewer:hover) .float-current {
  background: #19e3ff0e;
  border-color: #19e3ff99;
  box-shadow: 0 0 18px #19e3ff1a;
}
.icard:has(.viewer:hover) .trade-toggle {
  filter: brightness(1.15);
  transform: translateY(-1px);
  box-shadow: 0 0 24px #8b5cf680;
}
.modal-back {
  z-index: 2147483647;
  isolation: isolate;
  overscroll-behavior: contain;
  background: #020408;
  place-items: center;
  padding: 16px;
  display: grid;
  position: fixed;
  inset: 0;
  overflow: auto;
}
.modal {
  z-index: 1;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius);
  opacity: 1;
  background: #121826;
  flex-direction: column;
  width: min(980px, 100%);
  max-height: 94dvh;
  display: flex;
  position: relative;
  overflow: hidden;
  box-shadow: 0 24px 90px #000000d9;
}
.modal-head {
  border-bottom: 1px solid var(--line);
  justify-content: space-between;
  align-items: center;
  padding: 10px 14px;
  display: flex;
}
.modal-head .x {
  border: 1px solid var(--line-strong);
  width: 28px;
  height: 28px;
  color: var(--text);
  cursor: pointer;
  background: 0 0;
  border-radius: 50%;
  font-size: 16px;
  position: static;
}
.modal-frame {
  background: #05070c;
  border: 0;
  width: 100%;
  height: min(70vh, 640px);
}
.modal-foot {
  border-top: 1px solid var(--line);
  padding: 10px 14px;
}
.skin3d {
  --s3-accent: #19e3ff;
  color: #f4f7ff;
  isolation: isolate;
  background: #070a11;
  flex-direction: column;
  min-height: min(72vh, 680px);
  display: flex;
}
.skin3d:fullscreen {
  background: #070a11;
  width: 100vw;
  height: 100vh;
  min-height: 100vh;
}
.skin3d-head {
  z-index: 4;
  background: #080c14eb;
  border-bottom: 1px solid #ffffff14;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  height: 58px;
  padding: 0 18px;
  display: flex;
}
.skin3d-title {
  align-items: center;
  gap: 12px;
  min-width: 0;
  display: flex;
}
.skin3d-title strong {
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 14px;
  overflow: hidden;
}
.skin3d-live {
  color: var(--s3-accent);
  letter-spacing: 0.11em;
  white-space: nowrap;
  background: #19e3ff12;
  border: 1px solid #19e3ff4d;
  border-radius: 6px;
  align-items: center;
  gap: 6px;
  padding: 5px 8px;
  font-size: 10px;
  font-weight: 900;
  display: inline-flex;
}
.skin3d-live i {
  background: var(--s3-accent);
  width: 6px;
  height: 6px;
  box-shadow: 0 0 10px var(--s3-accent);
  border-radius: 50%;
  animation: 1.8s ease-in-out infinite s3pulse;
}
@keyframes s3pulse {
  50% {
    opacity: 0.35;
    transform: scale(0.75);
  }
}
.skin3d-head-actions {
  align-items: center;
  gap: 10px;
  display: flex;
}
.skin3d-status {
  color: #8f9bb3;
  font-size: 11px;
}
.skin3d-status.ready {
  color: #2ee59d;
}
.skin3d-status.error {
  color: #ff5470;
}
.skin3d-icon {
  color: #cbd5e8;
  cursor: pointer;
  background: #ffffff0a;
  border: 1px solid #ffffff1f;
  border-radius: 8px;
  place-items: center;
  width: 34px;
  height: 34px;
  display: grid;
}
.skin3d-icon:hover {
  color: #fff;
  border-color: var(--s3-accent);
}
.skin3d-icon svg,
.skin3d-reset svg {
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8px;
  stroke-linecap: round;
  stroke-linejoin: round;
  width: 17px;
  height: 17px;
}
.skin3d-canvas {
  background: radial-gradient(
    at 50% 44%,
    #1e3657cc 0%,
    #0c1422ed 40%,
    #070a11 78%
  );
  flex: 1;
  min-height: 480px;
  position: relative;
  overflow: hidden;
}
.skin3d-canvas:before {
  content: "";
  pointer-events: none;
  z-index: 1;
  background: linear-gradient(115deg, #19e3ff0d, #0000 34%, #8b5cf60d);
  position: absolute;
  inset: 0;
}
.skin3d-grid {
  transform-origin: 50% 0;
  pointer-events: none;
  background-image: linear-gradient(#53739e1f 1px, #0000 1px),
    linear-gradient(90deg, #53739e1f 1px, #0000 1px);
  background-size: 44px 44px;
  position: absolute;
  inset: 42% -10% -30%;
  transform: perspective(500px) rotateX(62deg);
  -webkit-mask-image: linear-gradient(#000c, #0000 68%);
  mask-image: linear-gradient(#000c, #0000 68%);
}
.skin3d-frame {
  z-index: 2;
  inset: 0;
  width: 100% !important;
  height: 100% !important;
  position: absolute !important;
}
.skin3d-frame iframe {
  border: 0;
  width: 100% !important;
  height: 100% !important;
}
.skin3d-loader {
  color: #aab6cd;
  z-index: 3;
  place-content: center;
  justify-items: center;
  gap: 14px;
  font-size: 13px;
  display: grid;
  position: absolute;
  inset: 0;
}
.skin3d-loader i {
  border: 2px solid #ffffff1a;
  border-top-color: var(--s3-accent);
  border-radius: 50%;
  width: 38px;
  height: 38px;
  animation: 0.8s linear infinite s3spin;
}
@keyframes s3spin {
  to {
    transform: rotate(360deg);
  }
}
.skin3d-hint {
  z-index: 3;
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
  color: #8491a9;
  white-space: nowrap;
  pointer-events: none;
  background: #04070cad;
  border: 1px solid #ffffff14;
  border-radius: 8px;
  padding: 7px 11px;
  font-size: 10px;
  position: absolute;
  bottom: 14px;
  left: 50%;
  transform: translate(-50%);
}
.skin3d-controls {
  z-index: 4;
  background: #090d16;
  border-top: 1px solid #ffffff14;
  align-items: center;
  gap: 16px;
  min-height: 64px;
  padding: 10px 16px;
  display: flex;
}
.skin3d-segment {
  background: #ffffff0d;
  border: 1px solid #ffffff14;
  border-radius: 9px;
  padding: 3px;
  display: flex;
}
.skin3d-segment button {
  color: #8f9bb3;
  cursor: pointer;
  background: 0 0;
  border: 0;
  border-radius: 6px;
  padding: 7px 13px;
  font: 600 11px/1 system-ui;
}
.skin3d-segment button.active {
  color: #fff;
  background: #1a2435;
  box-shadow: 0 1px 8px #00000059;
}
.skin3d-map {
  color: #7f8ba2;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  align-items: center;
  gap: 8px;
  font-size: 10px;
  display: flex;
}
.skin3d-map select {
  color: #dce5f5;
  background: #101725;
  border: 1px solid #ffffff1a;
  border-radius: 7px;
  width: auto;
  min-width: 110px;
  padding: 7px 28px 7px 9px;
  font-size: 11px;
}
.skin3d-reset {
  color: #9da9bd;
  cursor: pointer;
  background: 0 0;
  border: 1px solid #ffffff1a;
  border-radius: 8px;
  align-items: center;
  gap: 7px;
  margin-left: auto;
  padding: 8px 10px;
  font: 600 11px/1 system-ui;
  display: flex;
}
.skin3d-reset:hover {
  color: #fff;
  border-color: #19e3ff73;
}
.skin3d-fallback {
  text-align: center;
  background: radial-gradient(circle at 50% 45%, #18243a, #070a11 68%);
  place-content: center;
  justify-items: center;
  gap: 16px;
  height: 100%;
  min-height: 430px;
  padding: 30px;
  display: grid;
}
.skin3d-fallback.compact {
  z-index: 4;
  position: absolute;
  inset: 0;
}
.skin3d-fallback img {
  object-fit: contain;
  filter: drop-shadow(0 22px 30px #000000a6);
  width: min(70%, 560px);
  max-height: 310px;
}
.skin3d-fallback div {
  gap: 5px;
  display: grid;
}
.skin3d-fallback span {
  color: #8995aa;
  font-size: 12px;
}
@media (max-width: 700px) {
  .skin3d {
    min-height: 620px;
  }
  .skin3d-canvas {
    min-height: 430px;
  }
  .skin3d-status,
  .skin3d-map > span {
    display: none;
  }
  .skin3d-controls {
    flex-wrap: wrap;
    gap: 8px;
  }
  .skin3d-reset {
    margin-left: 0;
  }
  .skin3d-hint {
    display: none;
  }
}
.shot-stage {
  background: #05070c;
  place-items: center;
  min-height: 320px;
  max-height: 70vh;
  display: grid;
  position: relative;
  overflow: auto;
}
.shot-state {
  text-align: center;
  padding: 24px;
}
.shot {
  max-width: 100%;
  height: auto;
  display: none;
}
.shot.ready {
  display: block;
}
:root {
  --bg: #111216;
  --bg2: #15161b;
  --panel: #1b1d23;
  --panel-solid: #1b1d23;
  --panel2: #24262d;
  --line: #2a2c34;
  --line-strong: #3a3d47;
  --text: #f4f4f5;
  --muted: #92959f;
  --cyan: #ff8a1f;
  --violet: #ff9f43;
  --pink: #ff6846;
  --ok: #79d34d;
  --warn: #ffb648;
  --bad: #f15b64;
  --accent: #ff8a1f;
  --grad: linear-gradient(135deg, #ff9b32, #ff7a18);
  --glow: 0 10px 28px #ff7a1829;
  --radius: 10px;
}
html {
  background: var(--bg);
}
body {
  background: var(--bg);
  font-family:
    Inter,
    Segoe UI,
    Arial,
    sans-serif;
  font-size: 14px;
  line-height: 1.5;
}
body:before {
  content: "";
  pointer-events: none;
  z-index: -1;
  background: radial-gradient(850px 360px at 50% -180px, #ff841f14, #0000 70%);
  position: fixed;
  inset: 0;
}
.wrap {
  width: 100%;
  max-width: 1480px;
  margin: 0 auto;
  padding-left: 28px;
  padding-right: 28px;
}
header.top {
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
  background: #111216f7;
  border-bottom: 1px solid #272930;
  align-items: center;
  height: 68px;
  display: flex;
  box-shadow: 0 3px 18px #00000038;
}
header.top .wrap {
  gap: 36px;
  height: 100%;
  padding-top: 0;
  padding-bottom: 0;
}
.logo {
  letter-spacing: -0.4px;
  gap: 9px;
  font-size: 20px;
}
.logo i {
  background: var(--grad);
  width: 34px;
  height: 34px;
  box-shadow: none;
  border-radius: 9px;
}
.logo i:after {
  content: "⇄";
  color: #17120d;
  font-size: 17px;
}
.logo b {
  color: var(--accent);
  background: 0 0;
}
header.top nav {
  align-items: center;
  gap: 2px;
  height: 100%;
}
header.top nav a {
  color: #a6a8b0;
  border-bottom: 2px solid #0000;
  border-radius: 0;
  align-items: center;
  height: 100%;
  padding: 0 15px;
  font-size: 13px;
  font-weight: 650;
  display: flex;
}
header.top nav a:hover {
  color: #fff;
  border-bottom-color: var(--accent);
  background: #ffffff06;
}
.user .name {
  font-size: 13px;
}
.avatar {
  border-color: #42454f;
}
.user .btn {
  min-height: 34px;
}
h1 {
  letter-spacing: -0.65px;
  font-size: 30px;
  font-weight: 750;
}
h2 {
  font-size: 20px;
  font-weight: 700;
}
.lead {
  color: #a7a9b1;
}
.grad-text {
  background: var(--grad);
  -webkit-background-clip: text;
  background-clip: text;
}
a {
  color: #ff9b3b;
}
a:hover {
  color: #ffae62;
}
.card {
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  background: #1a1c21;
  border: 1px solid #292c33;
  border-radius: 10px;
  padding: 18px;
  transition:
    border-color 0.16s,
    background 0.16s,
    transform 0.16s,
    box-shadow 0.16s;
  box-shadow: 0 3px 12px #0000001f;
}
a.card:hover,
.card.hover:hover {
  background: #1d1f25;
  border-color: #3c3f48;
  transform: translateY(-1px);
  box-shadow: 0 12px 30px #0000003d;
}
.btn {
  background: var(--grad);
  color: #21160c;
  min-height: 38px;
  box-shadow: none;
  border-radius: 8px;
  padding: 9px 17px;
  font-size: 13px;
  font-weight: 750;
  transition:
    background 0.14s,
    border-color 0.14s,
    color 0.14s,
    transform 0.14s,
    box-shadow 0.14s;
}
.btn:hover {
  filter: none;
  background: linear-gradient(135deg, #ffad50, #ff8a1f);
  transform: translateY(-1px);
  box-shadow: 0 7px 18px #ff7a1833;
}
.btn.secondary {
  color: #e5e5e7;
  background: #24262d;
  border: 1px solid #373a43;
}
.btn.secondary:hover {
  color: #fff;
  box-shadow: none;
  background: #2b2d35;
  border-color: #51545e;
}
.btn.ok {
  color: #10210a;
  background: #7ed957;
}
.btn.bad {
  color: #ff9aa2;
  background: #3a2227;
  border: 1px solid #6d343d;
}
.btn.big {
  border-radius: 8px;
  padding: 12px 22px;
}
input,
textarea,
select {
  color: #f1f1f2;
  background: #17191e;
  border: 1px solid #30333b;
  border-radius: 8px;
  padding: 10px 12px;
}
input:hover,
textarea:hover,
select:hover {
  border-color: #444751;
}
input:focus,
textarea:focus,
select:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px #ff8a1f1f;
}
.tag {
  color: #aeb0b8;
  background: #25272e;
  border-color: #353842;
  border-radius: 5px;
  padding: 4px 8px;
  font-size: 10px;
  font-weight: 750;
}
.tag.open {
  color: #ffac5e;
  background: #ff8a1f14;
  border-color: #ff8a1f5c;
}
.tag.want {
  color: #ff9b78;
  background: #ff684612;
  border-color: #ff684657;
}
.msg {
  background: #1b1d23;
  border-color: #30323a;
  border-radius: 8px;
}
.msg.ok {
  background: #79d34d12;
  border-color: #79d34d59;
}
.msg.err {
  background: #f15b6412;
  border-color: #f15b6459;
}
.grid {
  grid-template-columns: repeat(auto-fill, minmax(172px, 1fr));
  gap: 10px;
}
.item {
  text-align: left;
  background: #1a1c21;
  border: 1px solid #282a31;
  border-radius: 8px;
  min-height: 202px;
  padding: 14px 11px 11px;
  transition:
    transform 0.16s,
    border-color 0.16s,
    background 0.16s,
    box-shadow 0.16s;
  box-shadow: 0 3px 10px #00000024;
}
.item:before {
  height: 2px;
  box-shadow: none;
}
.item:after {
  background: radial-gradient(
    150px 105px at 50% 31%,
    color-mix(in srgb, var(--rc) 13%, transparent),
    transparent 72%
  );
}
.item:hover {
  background: #1e2026;
  border-color: #3b3e47;
  transform: translateY(-2px);
  box-shadow: 0 11px 26px #00000047;
}
.item img {
  filter: drop-shadow(0 12px 13px #00000080);
  height: 112px;
  margin-bottom: 5px;
}
.item .n {
  min-height: 32px;
  font-size: 12px;
  font-weight: 650;
  line-height: 1.35;
}
.item .p {
  color: #898c96;
  font-size: 10px;
}
.item.pick:hover {
  transform: translateY(-2px);
}
.item.sel {
  border-color: var(--accent);
  box-shadow:
    0 0 0 1px var(--accent),
    0 8px 24px #ff7a1821;
}
.item.focus {
  border-color: #ffac5e;
  box-shadow: 0 0 0 1px #ff8a1f66;
}
.item.sel:after {
  background: var(--accent);
  color: #21160c;
}
.item-quick {
  background: linear-gradient(#0d0e112e, #0d0e114d 46%, #0d0e11f7);
  padding: 9px;
}
.item-quick-actions {
  justify-content: flex-end;
}
.item-quick-btn {
  background: #18191ef5;
  border-color: #444750;
  border-radius: 6px;
  min-height: 29px;
  box-shadow: 0 5px 14px #00000073;
}
.item-quick-btn.inspect {
  color: #ff9b3b;
  border-color: #ff8a1fa6;
}
.item-quick-btn.inspect:hover {
  background: var(--accent);
  color: #20140a;
}
.item-quick-btn.trade {
  color: #f0f0f2;
  border-color: #ffffff30;
}
.item-quick-btn.trade:hover {
  border-color: var(--accent);
  color: #ffae62;
}
.item-quick-float {
  box-shadow: none;
  background: #18191ef7;
  border-color: #ff8a1f6b;
  border-radius: 6px;
}
.item-quick-float span {
  color: #ff9b3b;
}
.toolbar {
  background: #111216;
  border-bottom: 1px solid #24262c;
  margin-top: 0;
  padding: 12px;
  top: 68px;
}
.toolbar input,
.toolbar select {
  background: #1a1c21;
}
.staging {
  background: #181a1f;
  border-color: #343740;
}
.staging .empty {
  background: #15171b;
  border-color: #343740;
}
.chip {
  background: #202228;
  border-color: #393c45;
  border-radius: 8px;
}
.chip button {
  background: #32343c;
}
.chip button:hover {
  background: #5a2d34;
}
.icard {
  background: #1a1c21;
  border-color: #30333b;
  border-radius: 9px;
}
.icard-img {
  background: radial-gradient(
      300px 180px at 50% 45%,
      color-mix(in srgb, var(--rc) 17%, transparent),
      transparent 74%
    ),
    #181a1f;
  border-bottom: 2px solid var(--rc);
  padding: 22px 16px 10px;
}
.icard-img img {
  max-height: 250px;
}
.icard-body {
  padding: 17px 18px 19px;
}
.icard-body h3 {
  font-size: 17px;
}
.float-current {
  border-radius: 7px;
}
.icard:has(.viewer:hover) .vbtn-3d {
  color: #20140a;
  background: var(--accent);
  border-color: var(--accent);
  box-shadow: 0 0 20px #ff8a1f57;
}
.icard:has(.viewer:hover) .float-current {
  box-shadow: none;
  background: #ff8a1f0b;
  border-color: #ff8a1f73;
}
.icard:has(.viewer:hover) .trade-toggle {
  box-shadow: 0 7px 20px #ff7a1833;
}
.vbtn {
  color: #bbbcc2;
  background: #18191ef0;
  border-color: #3b3e47;
  border-radius: 7px;
}
.vbtn:hover {
  color: #ff9b3b;
  border-color: var(--accent);
  background: #272930;
}
.ptable td {
  border-color: #2b2d34;
}
.ptable tr:hover td {
  background: #ffffff05;
}
.stat,
.step {
  background: #1a1c21;
  border-color: #292c33;
  border-radius: 9px;
}
.stat b {
  background: var(--grad);
  -webkit-background-clip: text;
  background-clip: text;
}
.step .num {
  background: var(--grad);
}
.profile-head {
  background: #1a1c21;
}
.profile-banner {
  opacity: 0.72;
  background: linear-gradient(110deg, #ff7618, #ffad45);
}
.tabs {
  border-color: #2c2e35;
}
.tabs a.on {
  border-color: var(--accent);
  color: #fff;
}
.modal-back {
  background: #0c0d10;
}
.modal {
  background: #191b20;
  border-color: #363942;
  border-radius: 10px;
}
.modal-head {
  background: #1f2127;
  border-color: #30323a;
  min-height: 48px;
}
.modal-foot {
  background: #1f2127;
  border-color: #30323a;
}
.skin3d {
  --s3-accent: #ff8a1f;
  background: #111216;
}
.skin3d-head,
.skin3d-controls {
  background: #191b20;
}
.skin3d-segment button.active {
  background: #30323a;
}
.skin3d-map select {
  background: #24262d;
}
.skin3d-reset:hover,
.skin3d-icon:hover {
  border-color: var(--s3-accent);
  color: #ffad62;
}
@media (max-width: 760px) {
  .wrap {
    padding-left: 14px;
    padding-right: 14px;
  }
  header.top {
    height: 60px;
  }
  header.top .wrap {
    gap: 12px;
  }
  .logo {
    font-size: 17px;
  }
  .logo i {
    width: 30px;
    height: 30px;
  }
  .grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .item {
    min-height: 190px;
  }
  .item img {
    height: 100px;
  }
  .user .name {
    display: none;
  }
}
